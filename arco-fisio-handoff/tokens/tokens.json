{
  "$description": "Tokens de Arco Fisio. 'light' está diseñado y validado. 'dark' es solo una propuesta pendiente de diseño.",
  "watch": { "size": 384, "ringRadius": 170, "progressRingRadius": 176, "center": [192, 192], "wavePeriod": 192 },
  "color": {
    "light": {
      "bg": "#EAF0F9", "paper": "#F7F9FD", "card": "#FFFFFF",
      "ink": "#0F1B3D", "ink2": "#4B5878", "line": "#D3DCEF",
      "acc": "#4263EB", "acc2": "#2B45B8", "tint": "#DCE4FF", "onacc": "#FFFFFF",
      "mint": "#4FD1B5", "mintd": "#0B6B58", "mintt": "#D6F5EE", "onm": "#06332B",
      "amber": "#FFB26B", "amberd": "#8F4504", "ambert": "#FFE9D2", "ona": "#3A1C00",
      "rose": "#F2668B", "rosed": "#A3234B", "roset": "#FDE0E8", "onr": "#3A0618",
      "water": "#4263EB", "shadow": "rgba(15,27,61,.13)"
    },
    "dark_proposal": {
      "bg": "#070B17", "paper": "#0B1020", "card": "#141B33",
      "ink": "#EAF0FF", "ink2": "#A3B0D4", "line": "#26305A",
      "acc": "#7C93FF", "acc2": "#A9B9FF", "tint": "#1C2650", "onacc": "#0B1020",
      "mint": "#4FD1B5", "mintd": "#7FE8CF", "mintt": "#0F3A34", "onm": "#06332B",
      "amber": "#FFB26B", "amberd": "#FFC995", "ambert": "#3D2A14", "ona": "#3A1C00",
      "rose": "#F2668B", "rosed": "#FF9BB5", "roset": "#3D1626", "onr": "#3A0618",
      "water": "#5B78FF", "shadow": "rgba(0,0,0,.5)"
    }
  },
  "typography": {
    "families": { "data": "'DM Sans', system-ui, sans-serif", "voice": "'Newsreader', Georgia, serif (cursiva)" },
    "scale": {
      "big":  { "family": "data", "weight": 700, "size": 88, "lineHeight": 1, "tracking": "-0.04em", "tabular": true },
      "mid":  { "family": "data", "weight": 700, "size": 48, "lineHeight": 1, "tracking": "-0.03em", "tabular": true },
      "ttl":  { "family": "data", "weight": 700, "size": 21, "lineHeight": 1.15 },
      "msg":  { "family": "voice", "style": "italic", "weight": 400, "size": 25, "lineHeight": 1.15 },
      "lbl":  { "family": "data", "weight": 500, "size": 13.5, "tracking": ".1em", "uppercase": true },
      "sub":  { "family": "data", "weight": 500, "size": 15, "lineHeight": 1.35 },
      "btn":  { "family": "data", "weight": 700, "size": 17 }
    }
  },
  "radius": { "pill": 99, "row": 26, "card": 30, "circle": "50%" },
  "touch": { "min": 44, "button": 48, "stepper": 56, "menuItem": 54 },
  "motion": {
    "loadingTotalMs": 3800,
    "waveDriftFrontS": 8, "waveDriftBackS": 13,
    "levelTransitionMs": 600, "levelEasing": "cubic-bezier(.3,.7,.3,1)",
    "stateColorChangeMs": 150, "holdMs": 1000, "calibrationMs": 3000
  },
  "waterOpacity": { "back": 0.16, "front": 0.30 },
  "session": { "defaultTolerance": 5, "example": { "target": 90, "painArc": [100, 125], "reps": 10, "sets": 3, "restSeconds": 30 } }
}
